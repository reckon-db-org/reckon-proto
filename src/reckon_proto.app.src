{application, reckon_proto, [
    {description,
     "Canonical Protocol Buffer + gRPC definitions for the ReckonDB "
     "event store. Proto-only — no Erlang behaviour. Exists as an OTP "
     "app so rebar3 consumers (reckon-gateway) can declare it as a "
     "git dep and point their grpc_plugin at proto/ in the fetched "
     "dep dir. Non-Erlang consumers (reckon-go, future SDKs) ignore "
     "the OTP metadata and pull from proto/ directly via buf."},
    {vsn, "0.4.0"},
    {registered, []},
    {applications, [kernel, stdlib]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"Codeberg", "https://codeberg.org/reckon-db-org/reckon-proto"}
    ]}
]}.
